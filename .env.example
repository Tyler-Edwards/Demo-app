# Required: LLM provider (pick one)
OVERMIND_API_KEY=ovr_...
OVERMIND_MODEL=ft-858cb84e-qwen2-5-7b-instruct
# OVERMIND_BASE_URL=https://api.overmindlab.ai/api/v1/chat/completions

# Or local Ollama instead of Overmind
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=llama3.2

# Required for Gmail read-only OAuth (local)
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/callback

# Encrypts the local session cookie (min 32 characters)
SESSION_SECRET=replace-with-a-long-random-secret-at-least-32-chars
