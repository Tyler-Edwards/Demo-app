# Overmind tracing (Python agent service)
OVERMIND_API_KEY=ovr_...

# Python agent service URL (Next.js calls this for LLM triage)
PYTHON_AGENT_URL=http://127.0.0.1:8000

# Required: LLM via Overmind inference (same key as tracing above)
OPENAI_MODEL=ft-1b4b9f25-qwen3-5-9b

# Or local Ollama instead of OpenAI
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=llama3.2

# Required for Gmail read-only OAuth (local)
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/callback

# Encrypts the local session cookie (min 32 characters)
SESSION_SECRET=replace-with-a-long-random-secret-at-least-32-chars
